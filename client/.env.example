# Same-origin deployments use /api (through the Vite proxy in development).
# No value is needed unless the API is hosted separately.
# VITE_API_BASE_URL=/api

# Set this to the deployed backend API URL when building the hosted frontend.
# Example: VITE_API_BASE_URL=https://api.example.com/api

# Required to render the Google Maps view.
VITE_GOOGLE_MAPS_API_KEY=
